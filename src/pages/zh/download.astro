try {
  const res = await API.getKvConfig(
    {
      k: "official.chat.web.url.text",
    },
    {
      headers: {
        "x-forwarded-for": Astro.locals.local_ip,
        "x-real-ip": Astro.locals.local_ip,
      },
    },
  );

  console.log(" Astro.locals.local_ip", Astro.locals.local_ip);

  posts = {
    ...posts,
    ...res.data,
  };

  console.log(res.data, "正确获取归属地的 ---1");

  console.log(res, "res---1");
} catch (error) {
  console.log(error, "--报错获取归属地的---1");
}

