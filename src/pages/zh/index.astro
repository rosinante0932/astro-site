            <img src="/public/assets/home/no1.svg" alt="多重安全保障 icon" />
            <span class="text-[#fff] text-[24px] font-600 pl-3">NO.01</span>
          </p>
        </div>
        <h3 class="py-[20px]">
          <span class="text-[32px] font-600 text-[#11254e]">多重安全保障</span>
        </h3>
