---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DOCKER_PROXY_IP } from "astro:env/server";
import { HttpsProxyAgent } from "https-proxy-agent";
import axios from "axios";
import { highlightPlaceholders } from "@/utils/common";
import API from "@/api/index.js";
import { t, resolveLocale, type Locale } from "@/lib/i18n";
import ForbiddenImage from "@/components/Forbidden.vue";
import nodeFetch from "@/services/service.node-fetch";
import undiciService from "@/services/service.undici";
import gotService from "@/services/service.got";
import superagentService from "@/services/service.superagent";
import service from "@/services/service.astro-fetch";
import Httpservice from "@/services/service.http";
import "@/assets/css/initial.css";
import RetryButton from "@/components/RetryButton.vue";

const proxy = DOCKER_PROXY_IP; // 你的代理地址

const agent = new HttpsProxyAgent(proxy);

const dockerNetAgentOptions =
  // DOCKER_PROXY_NET 让运维加到docker-compose的环境变量里面了，所以本地没有
  process.env.DOCKER_PROXY_NET === "true"
    ? {
        httpsAgent: agent,
        httpAgent: agent,
        timeout: 8000,
      }
    : {};

const locale: Locale = resolveLocale(Astro.currentLocale);
const title = t(locale, "访问受限制");
const referer = Astro.locals.referer;

let posts = {
  ip: "192.168.0.1",
  referer,
  country: "",
  city: "",
  value: "",
  clientIp: Astro.locals.clientIP,
  custom_ip: Astro.locals.clientIP,
};

console.log(Astro.locals.clientIP, "客户端ip");

console.log(process.env.DOCKER_PROXY_NET, "==================DOCKER_PROXY_NET");

const restrictionHtml = highlightPlaceholders(
  t(
    locale,
    "您所在的地区已被禁止访问我们的网站，给您造成的不便，敬请见谅。如有任何疑问，请联系24小时在线客服，我们将竭诚为您服务。",
  ),
);

