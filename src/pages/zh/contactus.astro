try {
  const res = await axios.get("https://api.ipify.org", {
    ...dockerNetAgentOptions,
    timeout: 8000,
  });

  console.log(res.data, "服务器ip");

  posts = {
    ...posts,
    ip: res.data,
  };
} catch (error) {
  console.log(error, "ip 获取错误");
}
---

<BaseLayout {title}>
  <input type="hidden" value={`客户端的custom_ip: ${JSON.stringify(posts)}`} />
  <input type="hidden" value={`客户端的custom_ip: ${posts.custom_ip}`} />
  <input type="hidden" value={`客户端的ip: ${posts.ip}`} />
  <input type="hidden" value={`服务端的ip: ${posts.clientIp}`} />
  <input type="hidden" value={`从哪里跳过来的: ${posts.referer}`} />
  <input type="hidden" value={`BOSS: ${process.env.BOSS}`} />
  <input type="hidden" value={`客服链接: ${posts.value}`} />
  <input type="hidden" value={`国家: ${posts.country}`} />
  <input type="hidden" value={`城市: ${posts.city}`} />
