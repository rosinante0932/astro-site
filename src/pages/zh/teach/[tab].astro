---
import BaseLayout from "@/layouts/BaseLayout.astro";

const tabs = [
    { key: "register", label: "如何注册", title: "如何注册 - 易换APP使用教程" },
    { key: "login", label: "如何登录", title: "如何登录 - 易换APP使用教程" },
    { key: "topup", label: "如何充值", title: "如何充值 - 易换APP使用教程" },
    { key: "transfer", label: "如何转账", title: "如何转账 - 易换APP使用教程" },
    { key: "withdraw", label: "如何提现", title: "如何提现 - 易换APP使用教程" },
    { key: "exchange", label: "如何换汇", title: "如何换汇 - 易换APP使用教程" },
    { key: "scan", label: "如何扫码", title: "如何扫码 - 易换APP使用教程" },
    { key: "life", label: "生活缴费", title: "生活缴费 - 易换APP使用教程" },
];

export function getStaticPaths() {
    return tabs.map((t) => ({
        params: { tab: t.key },
    }));
}

const { tab } = Astro.params;
const current = tabs.find((t) => t.key === tab) ?? tabs[0];

if (!tabs.some((t) => t.key === tab)) {
    return Astro.redirect(`/zh/teach/${tabs[0].key}`, 302);
}

const canonical = new URL(Astro.url);
canonical.search = "";
canonical.hash = "";
---

<BaseLayout
    title={current.title}
    description="易换APP使用教程，注册/登录/充值/转账/提现/换汇/扫码/生活缴费步骤说明"
>
    <section class="container mx-auto py-10 mt-[70px]">
        <h2 title="易换APP使用教程">
            <img
                src="/assets/teach/01.svg"
                alt="易换APP使用教程"
                class="mx-auto"
            />
        </h2>

        <link rel="canonical" href={canonical.toString()} />

        <link rel="alternate" hreflang="zh" href={canonical.toString()} />
        <link
            rel="alternate"
            hreflang="en"
            href={canonical.toString().replace("/zh/", "/en/")}
        />
        <link
            rel="alternate"
            hreflang="th"
            href={canonical.toString().replace("/zh/", "/th/")}
        />
        <link
            rel="alternate"
            hreflang="vi"
            href={canonical.toString().replace("/zh/", "/vi/")}
        />
        <link
            rel="alternate"
            hreflang="ko"
            href={canonical.toString().replace("/zh/", "/ko/")}
        />
        <link
            rel="alternate"
            hreflang="km"
            href={canonical.toString().replace("/zh/", "/km/")}
        />
        <link
            rel="alternate"
            hreflang="x-default"
            href={canonical.toString().replace("/zh/", "/en/")}
        />

        <nav
            class="mt-8 flex flex-wrap justify-center gap-4"
            aria-label="教程导航"
        >
            {
                tabs.map((t) => (
                    <a
                        title={t.label}
                        href={`/zh/teach/${t.key}`}
                        class={`px-12 text-[18px] py-4 rounded-full shadow  font-bold
            ${
                t.key === current.key
                    ? "bg-[linear-gradient(127.31deg,#3feae4_-9.27%,#5383ff_95.74%)] text-white"
                    : "bg-white text-[#6b7280]"
            }`}
                        aria-current={
                            t.key === current.key ? "page" : undefined
                        }
                    >
                        {t.label}
                    </a>
                ))
            }
        </nav>

        <article
            class="w-[900px] mx-auto
             mt-10 bg-white/70 rounded-3xl p-8 rounded-[40px]
             border border-3 border-solid border-[#fff] bg-[rgba(255,255,255,0.7)]"
        >
            {
                current.key === "register" && (
                    <>
                        <h3>
                            <img src="/public/assets/teach/1/1.png" alt="" />
                        </h3>
                        <h3>
                            <img src="/public/assets/teach/1/2.png" alt="" />
                        </h3>
                        <h3>
                            <img src="/public/assets/teach/1/3.png" alt="" />
                        </h3>
                        <h3>
                            <img src="/public/assets/teach/1/4.png" alt="" />
                        </h3>
                    </>
                )
            }

            {
