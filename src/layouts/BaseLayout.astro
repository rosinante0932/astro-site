---
import { resolveLocale, type Locale } from "@/configs/i18n.config";
import BaseHead from "../components/BaseHead.astro";
import LangSwitcher from "../components/LangSwitcher.astro";
import VConsole from "../components/VConsole.astro";
import Qrcode from "@/components/Qrcode.vue";
const locale: Locale = resolveLocale(Astro.currentLocale);
const { title, description } = Astro.props;
const url = new URL(Astro.url);
const search = Astro.url.search;
console.log(Astro.url.search, "========search");
console.log(Astro.url, "==========Astro.url");
console.log(url, "==============url");
---

<html lang={Astro.currentLocale} class="h-[100%] bg-[#f0f5f9]">
  <head>
    <BaseHead {title} {description} />

    <script is:inline>
      (() => {
        try {
          const raw = localStorage.getItem("ui");
          const sel = raw ? JSON.parse(raw).theme : "system";
          const prefersDark = window.matchMedia?.(
            "(prefers-color-scheme: dark)",
          ).matches;
          const actual =
            sel === "dark"
              ? "dark"
              : sel === "light"
                ? "light"
                : prefersDark
                  ? "dark"
                  : "light";
          if (actual === "dark") document.documentElement.classList.add("dark");
          document.documentElement.dataset.theme = actual;
        } catch {}

        const fullPath = location.pathname;
        // 去掉语言前缀，例如 /en/download -> /download
        const path =
          fullPath.replace(/^\/(zh|en|th)(\/|$)/, "/").replace(/\/+$/, "") ||
          "/";

        window.requestAnimationFrame(() => {
          document.querySelectorAll("[data-nav]").forEach((el) => {
            const nav =
              (el.getAttribute("data-nav") || "").replace(/\/+$/, "") || "/";
            const active =
              nav === "/"
                ? path === "/"
                : path === nav || path.startsWith(nav + "/");
            if (active) {
              el.style.color = "#2996f5";
              el.style.fontWeight = 600;
              const arrow = el.nextElementSibling;
              if (arrow && arrow.tagName === "IMG") arrow.style.opacity = 1;
            }
          });

          // teach 系列：高亮“新手教程”标题
          if (path.startsWith("/teach")) {
            const dropdown = document.getElementById("teach-dropdown");
            const arrow = document.getElementById("teach-arrow");
            if (dropdown) {
              dropdown
                .querySelector("span")
                ?.setAttribute("style", "color:#2996f5;font-weight:600;");
            }
            if (arrow) arrow.style.opacity = 1;
          }
        });
      })();
    </script>
  </head>
  <body class="h-[100%] font-sans antialiased text-gray-800 overflow-x-hidden">
    <header
      class="xs:hidden sm:hidden md:hidden lg:hidden xl:block h-[70px] fixed left-0 right-0 z-100 bg-[transparent]"
    >
      <div
        class="container lg:max-w-[1280px] mx-auto py-4 flex items-center justify-between mx-auto"
      >
        <h1
          title="易换官网：便捷快速，安全可靠，全球多国币种，一站式解决！轻松畅享全球支付与兑换服务~"
        >
          <a href={`/${search}`} class="text-xl font-bold">
            <img
              width="90"
              height="36"
              loading="eager"
              decoding="async"
              src={`/assets/svg/logo-${locale === "zh" ? "zh" : locale === "en" ? "en" : "en"}.svg`}
              alt="易换官网商标"
            />
          </a>
        </h1>

        <div class="group flex flex-col items-center justify-center">
          <a
            href="/"
            data-nav="/"
            class="group-hover:text-[#2996f5] group-hover:font-600"
          >
            首页
          </a>
          <img
            src="/assets/header/hover.svg"
            alt=""
            class="group-hover:opacity-100 opacity-0"
          />
        </div>

        <div class="group flex flex-col items-center justify-center">
          <a
            href="/download"
            data-nav="/download"
            class="group-hover:text-[#2996f5] group-hover:font-600"
          >
            下载APP
          </a>
          <img
            src="/assets/header/hover.svg"
            alt=""
            class="group-hover:opacity-100 opacity-0"
          />
        </div>

        <div class="group flex flex-col items-center justify-center">
          <a
            href="/aboutus"
            data-nav="/aboutus"
            class="group-hover:text-[#2996f5] group-hover:font-600"
          >
            关于我们
          </a>
          <img
            src="/assets/header/hover.svg"
            alt=""
            class="group-hover:opacity-100 opacity-0"
          />
        </div>

        <div class="group flex flex-col items-center justify-center">
          <a
            href="/service"
            data-nav="/service"
            class="group-hover:text-[#2996f5] group-hover:font-600"
          >
            易换服务
          </a>
          <img
            src="/assets/header/hover.svg"
            alt=""
            class="group-hover:opacity-100 opacity-0"
          />
        </div>

        <div class="group flex flex-col items-center justify-center">
          <a
            href="/contactus"
            data-nav="/contactus"
            class="group-hover:text-[#2996f5] group-hover:font-600"
          >
            联系我们
          </a>
          <img
            src="/assets/header/hover.svg"
            alt=""
            class="group-hover:opacity-100 opacity-0"
          />
        </div>

        <div class="flex items-center justify-center">
          <div class="relative inline-block" id="teach-dropdown">
            <span
              class="cursor-pointer text-[#1f2937] hover:text-[#2996f5] hover:font-600"
            >
              新手教程
            </span>

            <img
              src="/assets/header/hover.svg"
              alt=""
              class="mx-auto opacity-0 transition-opacity"
              id="teach-arrow"
            />

            <ul
              id="teach-menu"
              class="absolute top-[50px] left-[-50px]
             w-[180px] bg-white py-[10px]
             shadow-[0_10px_30px_rgba(0,0,0,0.12)]
             opacity-0 translate-y-2 pointer-events-none
             transition-all duration-200 ease-out"
            >
              <li>
                <a
                  href="/teach-yh/register"
                  data-nav="/teach-yh/register"
                  class="block p-[10px] text-[#7281a2] text-[14px]
                 hover:bg-[#eef5fe] hover:text-[#2996f5]"
                >
                  易换APP使用教程
                </a>
              </li>

              <li>
                <a
                  href="/teach-dx/download"
                  data-nav="/teach-dx/download"
                  class="block p-[10px] text-[#7281a2] text-[14px]
                 hover:bg-[#eef5fe] hover:text-[#2996f5]"
                >
                  德信教程
                </a>
              </li>

              <li>
                <a
                  href="/teach-mk/deposit"
                  data-nav="/teach-mk/deposit"
                  class="block p-[10px] text-[#7281a2] text-[14px]
                 hover:bg-[#eef5fe] hover:text-[#2996f5]"
                >
                  MK教程
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="group flex flex-col items-center justify-center">
          <a
            href="/qa"
            data-nav="/qa"
            class="group-hover:text-[#2996f5] group-hover:font-600"
          >
            常见问题
          </a>
          <img
            src="/assets/header/hover.svg"
            alt=""
            class="group-hover:opacity-100 opacity-0"
          />
        </div>

        <nav class="flex items-center gap-3">
          <LangSwitcher />
        </nav>
      </div>
    </header>
    <header
      class="xl:hidden block fixed left-0 right-0 z-100 py-2 px-4
      flex items-center justify-between
      bg-[linear-gradient(0deg,#edf2ff,#edf2ff),linear-gradient(0deg,#fff,#fff)]"
    >
      <img src="/assets/header/logo.svg" class="h-7" alt="" />
      <div>
        <img src="/assets/header/menu.svg" alt="" class="h-5" />
      </div>
    </header>

    <main class="container mx-auto py-4">
      <slot />

      <ul class="fixed xl:right-10 right-2 xl:bottom-10 bottom-15">
        <li
          class="mb-[20px] xl:w-[70px] xl:h-[70px] w-10 h-10 rounded-[50%] shadow-[0_16px_24px_0_rgba(19,78,238,0.2)]"
        >
          <img
            src="/assets/home/16.svg"
            alt="telegram"
            class="xl:w-[70px] xl:h-[70px] w-10 h-10"
          />
        </li>
        <li
          class="mb-[20px] xl:w-[70px] xl:h-[70px] w-10 h-10 mb-[20px] rounded-[50%] shadow-[0_16px_24px_0_rgba(19,78,238,0.2)]"
        >
          <img
            src="/assets/home/17.svg"
            alt="客服链接"
            class="xl:w-[70px] xl:h-[70px] w-10 h-10"
          />
        </li>
        <li
          class="shadow-[0_16px_24px_0_rgba(19,78,238,0.2)] mb-[20px] rounded-[50%] shadow-[0_16px_24px_rgba(49,76,154,0.12)]
         bg-[linear-gradient(127.31deg,#3feae4_-9.27%,#5383ff_95.74%)] xl:w-[70px] xl:h-[70px] w-10 h-10 flex items-center justify-center"
        >
          <img
            src="/assets/home/18.svg"
            alt=""
            class="xl:w-[40px] xl:h-[40px] w-6 h-6"
          />
        </li>
      </ul>
    </main>
    <footer class="xs:hidden sm:hidden md:hidden lg:hidden xl:block bg-[#fff]">
      <div
        class="flex container lg:max-w-[1280px] mx-auto justify-between items-center"
      >
        <dl class="flex gap-10 items-center justify-between py-[34px]">
          <dt class="w-[100px] flex items-center">
            <img src="/assets/yhicon.png" alt="" class="w-[80px] h-[80px]" />
          </dt>
          <dd class="grid gap-x-20 gap-y-5 grid-cols-4">
            <a href="/" data-nav="/">首页</a>
            <a href="/aboutus" data-nav="/aboutus">关于我们</a>
            <a href="/contactus" data-nav="/contactus">联系我们</a>
            <a href="/qa" data-nav="/qa">常见问题</a>
            <a href="/download" data-nav="/download">下载APP</a>
            <a href="/service" data-nav="/service">易换服务</a>
            <a href="/teach-yh/register" data-nav="/teach-yh/register"
              >新手教程</a
            >
          </dd>
        </dl>
        <ul
          class="bg-[linear-gradient(rgba(70,204,237,0.21),_rgb(77,165,247))] w-[120px]
          rounded-lg h-[130px] flex items-center justify-center flex-col"
        >
          <Qrcode
            client:only
            url="https://baidu.com"
            size="100"
            className="w-[70px] h-[70px] flex items-center justify-center bg-[#fff] mt-[20px]"
          />
          <p class="py-[3px]">
            <span class="text-[14px] text-[#fff]">下载APP</span>
          </p>
        </ul>
      </div>
    </footer>

    <footer class="flex xl:hidden bg-[#fff] p-4 pb-20 justify-between">
      <ul
        class="bg-[linear-gradient(rgba(70,204,237,0.21),_rgb(77,165,247))]
        w-20 rounded-lg h-25 flex items-center justify-center flex-col"
      >
        <Qrcode
          iconSize="20"
          client:only
          url="https://baidu.com"
          size="60"
          className="w-20 h-20 flex items-center justify-center mt-[20px]"
        />
        <p class="py-[3px]">
          <span class="text-xs text-[#fff]">下载APP</span>
        </p>
      </ul>

      <nav class="grid gap-x-8 gap-y-6 grid-cols-3 text-sm">
        <a href="/" data-nav="/">首页</a>
        <a href="/aboutus" data-nav="/aboutus">关于我们</a>
        <a href="/contactus" data-nav="/contactus">联系我们</a>
        <a href="/qa" data-nav="/qa">常见问题</a>
        <a href="/download" data-nav="/download">下载APP</a>
        <a href="/service" data-nav="/service">易换服务</a>
        <a href="/teach-yh/register" data-nav="/teach-yh/register">新手教程</a>
      </nav>
    </footer>

    <!-- scroll  -->
    <script is:inline>
      (() => {
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const oHeader = document.querySelector("header");
            if (oHeader)
              oHeader.style.backgroundColor =
                window.scrollY >= 1 ? "#fff" : "transparent";
            ticking = false;
          });
        };
        window.addEventListener("scroll", onScroll, { passive: true });
      })();
    </script>

    <!-- 新手教程下拉 -->
    <script is:inline>
      (() => {
        const dropdown = document.getElementById("teach-dropdown");
        const menu = document.getElementById("teach-menu");
        const arrow = document.getElementById("teach-arrow");

        if (dropdown && menu && arrow) {
          let timer;

          const open = () => {
            clearTimeout(timer);
            menu.classList.remove(
              "opacity-0",
              "translate-y-2",
              "pointer-events-none",
            );
            menu.classList.add(
              "opacity-100",
              "translate-y-0",
              "pointer-events-auto",
            );
            arrow.style.opacity = "1";
          };

          const close = () => {
            timer = setTimeout(() => {
              menu.classList.add(
                "opacity-0",
                "translate-y-2",
                "pointer-events-none",
              );
              menu.classList.remove(
                "opacity-100",
                "translate-y-0",
                "pointer-events-auto",
              );
              arrow.style.opacity = "0";
            }, 120);
          };

          dropdown.addEventListener("mouseenter", open);
          dropdown.addEventListener("mouseleave", close);
        }
      })();
    </script>

    <VConsole enabled={true} />
    <!-- <footer class="container mx-auto p-4 text-center text-sm text-gray-500">
      © {new Date().getFullYear()} AstroVue. All rights reserved.
    </footer> -->
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
  }
  .container {
    max-width: 1100px;
  }
</style>
